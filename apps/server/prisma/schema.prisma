// Kidora — Parental control data model
// SQLite for local/dev. Swap provider to "postgresql" for production (Vercel/Neon).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─────────────────────────────────────────────────────────────
// Accounts
// ─────────────────────────────────────────────────────────────

model Parent {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("owner") // owner | guardian
  weeklyReportEmail Boolean @default(true) // receive the weekly usage summary by email
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  children      Child[]
  alerts        Alert[]
  auditLogs     AuditLog[]
  guardianships Guardianship[]
  pushSubs      PushSub[]
}

// Web Push subscription (browser push notifications).
model PushSub {
  id        String   @id @default(cuid())
  parentId  String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  parent Parent @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([parentId])
}

// Additional (co-)guardian access to a child, beyond the owner (Child.parentId).
model Guardianship {
  id        String   @id @default(cuid())
  parentId  String
  childId   String
  role      String   @default("guardian")
  createdAt DateTime @default(now())

  parent Parent @relation(fields: [parentId], references: [id], onDelete: Cascade)
  child  Child  @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId])
  @@index([parentId])
  @@index([childId])
}

// Audit trail of sensitive account actions.
model AuditLog {
  id       String   @id @default(cuid())
  parentId String
  action   String // login | child.create | rule.change | time.grant | command | child.delete ...
  detail   String?
  ip       String?
  ts       DateTime @default(now())

  parent Parent @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([parentId, ts])
}

model Child {
  id        String    @id @default(cuid())
  parentId  String
  name      String
  birthDate DateTime?
  avatar    String? // emoji or url
  paused    Boolean   @default(false) // internet/app pause "right now"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  parent         Parent           @relation(fields: [parentId], references: [id], onDelete: Cascade)
  devices        Device[]
  appRules       AppRule[]
  webRules       WebRule[]
  screenTime     ScreenTimeRule?
  webFilter      WebFilterConfig?
  activityEvents ActivityEvent[]
  appUsages      AppUsage[]
  webVisits      WebVisit[]
  locationPings  LocationPing[]
  geofences      Geofence[]
  alerts         Alert[]
  commands       Command[]
  timeRequests   TimeRequest[]
  timeGrants     TimeGrant[]
  watchedKeywords WatchedKeyword[]
  screenshots    Screenshot[]
  routines       Routine[]
  guardianships  Guardianship[]

  @@index([parentId])
}

// Time-window profile that blocks selected apps (e.g. school hours).
model Routine {
  id            String   @id @default(cuid())
  childId       String
  name          String
  enabled       Boolean  @default(true)
  days          String   @default("[]") // JSON weekday keys ["mon",...]
  start         String   @default("08:00")
  end           String   @default("16:00")
  blockedAppIds String   @default("[]") // JSON ["steam.exe","com.roblox.client"]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
}

model Device {
  id           String    @id @default(cuid())
  childId      String
  name         String
  platform     String // windows | android | ios | macos
  model        String?
  enrollToken  String    @unique // used by agent to authenticate
  enrolled     Boolean   @default(false)
  lastSeen     DateTime?
  agentVersion String?
  battery      Int? // 0-100
  online       Boolean   @default(false)
  createdAt    DateTime  @default(now())

  child          Child           @relation(fields: [childId], references: [id], onDelete: Cascade)
  activityEvents ActivityEvent[]
  appUsages      AppUsage[]
  webVisits      WebVisit[]
  locationPings  LocationPing[]
  commands       Command[]

  @@index([childId])
}

// ─────────────────────────────────────────────────────────────
// Rules / Policies
// ─────────────────────────────────────────────────────────────

model ScreenTimeRule {
  id          String   @id @default(cuid())
  childId     String   @unique
  enabled     Boolean  @default(true)
  dailyLimits String   @default("{}") // JSON { "mon":120, ... } minutes/weekday
  bedtimes    String   @default("[]") // JSON [{days:[],start:"21:00",end:"07:00"}]
  updatedAt   DateTime @updatedAt

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model AppRule {
  id                String   @id @default(cuid())
  childId           String
  appId             String // package name / exe name
  appName           String
  category          String?
  action            String   @default("allow") // allow | block | limit
  dailyLimitMinutes Int?
  updatedAt         DateTime @updatedAt

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, appId])
  @@index([childId])
}

model WebRule {
  id        String   @id @default(cuid())
  childId   String
  kind      String   @default("domain") // domain | category
  value     String // "pornhub.com" or "adult"
  action    String   @default("block") // allow | block
  updatedAt DateTime @updatedAt

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, kind, value])
  @@index([childId])
}

model WebFilterConfig {
  id                String   @id @default(cuid())
  childId           String   @unique
  safeSearch        Boolean  @default(true)
  blockUnknown      Boolean  @default(false)
  blockedCategories String   @default("[]") // JSON array of category keys
  updatedAt         DateTime @updatedAt

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────
// Telemetry / Activity
// ─────────────────────────────────────────────────────────────

model ActivityEvent {
  id       String   @id @default(cuid())
  childId  String
  deviceId String
  type     String // app_open | web_visit | search | location | screen_on | blocked
  title    String?
  detail   String?
  category String?
  blocked  Boolean  @default(false)
  ts       DateTime @default(now())

  child  Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([childId, ts])
  @@index([deviceId, ts])
}

model AppUsage {
  id        String   @id @default(cuid())
  childId   String
  deviceId  String
  appId     String
  appName   String
  category  String?
  date      String // YYYY-MM-DD local
  seconds   Int      @default(0)
  updatedAt DateTime @updatedAt

  child  Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, appId, date])
  @@index([childId, date])
}

model WebVisit {
  id       String   @id @default(cuid())
  childId  String
  deviceId String
  domain   String
  url      String?
  title    String?
  category String?
  blocked  Boolean  @default(false)
  ts       DateTime @default(now())

  child  Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([childId, ts])
}

model LocationPing {
  id       String   @id @default(cuid())
  childId  String
  deviceId String
  lat      Float
  lng      Float
  accuracy Float?
  address  String?
  ts       DateTime @default(now())

  child  Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([childId, ts])
}

model Geofence {
  id            String   @id @default(cuid())
  childId       String
  name          String
  lat           Float
  lng           Float
  radius        Int      @default(150) // meters
  notifyOnEnter Boolean  @default(true)
  notifyOnExit  Boolean  @default(true)
  createdAt     DateTime @default(now())

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
}

// ─────────────────────────────────────────────────────────────
// Alerts & Commands
// ─────────────────────────────────────────────────────────────

model Alert {
  id       String   @id @default(cuid())
  parentId String
  childId  String
  type     String // blocked_attempt | bedtime | limit_reached | panic | keyword | geofence | new_app
  severity String   @default("info") // info | warning | critical
  message  String
  read     Boolean  @default(false)
  ts       DateTime @default(now())

  parent Parent @relation(fields: [parentId], references: [id], onDelete: Cascade)
  child  Child  @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([parentId, read])
  @@index([childId, ts])
}

model Command {
  id        String   @id @default(cuid())
  childId   String
  deviceId  String?
  type      String // lock | unlock | pause | resume | block_app | message | locate | screenshot
  payload   String   @default("{}") // JSON
  status    String   @default("pending") // pending | delivered | done | failed
  result    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  child  Child   @relation(fields: [childId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([deviceId, status])
}

// A child's request for extra screen time (parent approves/denies).
model TimeRequest {
  id        String   @id @default(cuid())
  childId   String
  minutes   Int
  reason    String?
  status    String   @default("pending") // pending | approved | denied
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, status])
}

// On-demand screen capture from a device (base64 JPEG data URL).
model Screenshot {
  id        String   @id @default(cuid())
  childId   String
  deviceId  String?
  dataUrl   String // data:image/jpeg;base64,...
  createdAt DateTime @default(now())

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, createdAt])
}

// Parent-defined keyword to watch for in searches & page titles.
model WatchedKeyword {
  id        String   @id @default(cuid())
  childId   String
  term      String
  createdAt DateTime @default(now())

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, term])
  @@index([childId])
}

// Bonus minutes granted to a child for a specific day (extends the daily limit).
model TimeGrant {
  id        String   @id @default(cuid())
  childId   String
  date      String // YYYY-MM-DD
  minutes   Int
  source    String   @default("parent") // parent | request
  createdAt DateTime @default(now())

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, date])
}
