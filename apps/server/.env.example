# Kidora server — environment variables
# Copy to .env and adjust.

# Database — the driver is auto-selected from the URL scheme (no code change):
#   file:…        -> SQLite   (dev default, better-sqlite3)
#   postgres://…  -> PostgreSQL (prod, pg)  e.g.
#   DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
DATABASE_URL="file:./dev.db"

# Optional: force the Prisma schema dialect at build time (prisma generate) when
# DATABASE_URL is not available during the build. Values: postgresql | sqlite.
# DATABASE_PROVIDER="postgresql"

# Secret used to sign session JWTs. CHANGE THIS in production.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="dev-insecure-secret-change-me-in-production-kidora"

# 32-byte key (base64 or hex) for encrypting sensitive data at rest (screenshots).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If unset, a deterministic DEV key is used (NOT for production).
DATA_ENC_KEY=""

# Public app URL — used in emails for the "Open dashboard" link.
# APP_URL="https://kidora.example.com"

# Canonical site origin — used for OpenGraph/sitemap and the password-reset link
# in emails. Falls back to the Vercel deployment URL, then localhost.
# NEXT_PUBLIC_SITE_URL="https://kidora.example.com"

# Web push (optional). Generate a key pair: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:admin@kidora.example.com"

# Outgoing email (optional). Enables the weekly report emails. Without SMTP_HOST,
# mail is disabled and the cron is a no-op (it still reports who *would* be emailed).
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"            # 465 for implicit TLS
# SMTP_SECURE="false"        # "true" for port 465
# SMTP_USER="apikey-or-user"
# SMTP_PASS="••••••"
# MAIL_FROM="Kidora <no-reply@kidora.app>"

# Protects the cron endpoints (/api/cron/reports, /api/cron/cleanup,
# /api/cron/offline-check). Vercel Cron sends it automatically as
# `Authorization: Bearer $CRON_SECRET`. Required in production.
# CRON_SECRET=""

# Data retention: telemetry older than this many days is purged by the daily
# cleanup cron (/api/cron/cleanup). Default 90, clamped 7..3650.
# RETENTION_DAYS="90"

# "Device offline" alert: hours of silence before alerting the parent that a
# device stopped reporting (/api/cron/offline-check). Default 12, clamped 1..168.
# OFFLINE_ALERT_HOURS="12"
