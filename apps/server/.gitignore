# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright e2e
/test-results/
/playwright-report/
/playwright/.cache/
e2e-test.db
prisma/e2e-test.db

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# generated VAPID keypair (contains the PRIVATE push key — never commit)
.vapid.json
# self-host backups
/backups/

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
