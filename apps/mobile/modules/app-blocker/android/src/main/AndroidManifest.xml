<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Foreground-app watcher that enforces the parent's block list. The system
         binds it via BIND_ACCESSIBILITY_SERVICE (only the OS can), so exported is
         required. The user must enable it once in Accessibility settings. -->
    <service
      android:name="app.kidora.appblocker.KidoraAccessibilityService"
      android:label="Kidora"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
      android:exported="true">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/kidora_accessibility_service" />
    </service>
  </application>
</manifest>
