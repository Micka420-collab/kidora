{
  "name": "kidora-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:child": "cross-env APP_ROLE=child expo start",
    "start:parent": "cross-env APP_ROLE=parent expo start",
    "android": "expo start --android",
    "build:child": "eas build -p android --profile child",
    "build:parent": "eas build -p android --profile parent",
    "build:child:apk": "eas build -p android --profile child-apk --non-interactive",
    "build:parent:apk": "eas build -p android --profile parent-apk --non-interactive",
    "build:apks": "npm run build:parent:apk && npm run build:child:apk",
    "release:apks": "node scripts/release-apks.mjs",
    "test": "jest"
  },
  "dependencies": {
    "expo": "^52.0.0",
    "expo-asset": "~11.0.5",
    "expo-build-properties": "~0.13.0",
    "expo-constants": "~17.0.0",
    "expo-font": "~13.0.4",
    "expo-linear-gradient": "~14.0.0",
    "expo-linking": "~7.0.0",
    "expo-location": "~18.0.0",
    "expo-notifications": "~0.29.14",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-task-manager": "~12.0.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.12",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.6",
    "react-test-renderer": "18.3.1",
    "typescript": "~5.3.3"
  },
  "private": true
}
