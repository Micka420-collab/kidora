# Copy to `.env` next to docker-compose.yml, then fill in the values.
#   docker compose up -d

# REQUIRED — session signing key. Generate: openssl rand -base64 48
AUTH_SECRET=

# Recommended — encryption at rest (screenshots, TOTP, AI keys). 32 bytes base64.
#   Generate: openssl rand -base64 32
DATA_ENC_KEY=

# Recommended — derives the Ed25519 key that signs agent policies. Any long random string.
#   Generate: openssl rand -base64 48
POLICY_SIGNING_SEED=

# Recommended — enables the in-process scheduler (retention / offline-check / reports).
#   Generate: openssl rand -base64 24
CRON_SECRET=

# Optional — Postgres password (defaults to "kidora" if unset).
POSTGRES_PASSWORD=kidora

# Optional — public URL used for links, PWA install and web push (e.g. https://kidora.mondomaine.fr).
NEXT_PUBLIC_SITE_URL=
